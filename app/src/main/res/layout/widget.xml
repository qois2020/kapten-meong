<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/w_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="😺 Kapten Meong"
        android:textColor="#FF1F3A5F"
        android:textSize="13sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_steps"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="0 langkah"
        android:textColor="#FF1F3A5F"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/w_goal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="target 8.000"
        android:textColor="#FF5B6F8A"
        android:textSize="12sp" />

    <ProgressBar
        android:id="@+id/w_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="10dp"
        android:layout_marginTop="6dp"
        android:max="100"
        android:progress="0"
        android:progressTint="#FF2E86DE"
        android:progressBackgroundTint="#FFD6E6F7" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/w_water"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="💧 0/8 gelas"
            android:textColor="#FF1F3A5F"
            android:textSize="13sp" />

        <Chronometer
            android:id="@+id/w_fast"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FF6A58D0"
            android:textSize="13sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/w_eat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🍽️ Jendela makan"
            android:textColor="#FF5B6F8A"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
